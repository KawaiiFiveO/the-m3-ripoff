function disableForm(theform) {
	if (document.all || document.getElementById) {
		for (i = 0; i < theform.length; i++) {
			var tempobj = theform.elements[i];
			if (tempobj.type.toLowerCase() == "submit")
				tempobj.disabled = true ;
		}
		return true;
	}
	else {
		return true;
	}
}

var subcount=0 ;
function countsubmit() {
	if (subcount == 0) {
		subcount++ ;
		return true ;
	}
	else {
		alert("Your message has already been submitted.\nPlease wait.");
		return false ;
	}
}

function insimg() {
	toins=prompt("Enter the URL for the image you would like inserted\n(example: http://members.roadfly.org/youruserid/yourpic.jpg)","") ;
	if (toins!=null && toins!="") {
		toins="\r[IMG]"+toins+"[/IMG]";
		document.postreply.messagebody.value+=toins ;
	}
}

function insimg2() {
	list = document.postreply.webfiles ;
	toins= list.options[list.selectedIndex].value ;
	if (toins!=null && toins!="") {
		toins="\r[IMG]"+toins+"[/IMG]";
		document.postreply.messagebody.value+=toins ;
	}
}

function insurl() {
	toins=prompt("Enter the full URL for the link\n(example: http://www.roadfly.org/)","") ;
	if (toins!=null && toins!="") {
		toins2=prompt("Optional: enter the text to be displayed for the link\n(default will be \""+toins+"\")","") ;
		if (toins2!= null && toins2!="") {
			toins="\r[URL="+toins+"]"+toins2+"[/URL]";
		}
		else {
			toins="\r[URL]"+toins+"[/URL]";
		}
		document.postreply.messagebody.value+=toins ;
	}
}


